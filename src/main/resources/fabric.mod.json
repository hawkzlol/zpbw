{
  "schemaVersion": 1,
  "id": "zpbw",
  "version": "${version}",
  "name": "Zero Ping Blinkwarp",
  "description": "ZPBW: local blinkwarp prediction with ordered packet holding, genuine server reconciliation and server-packet tick timeouts.",
  "environment": "client",
  "license": "MIT",
  "entrypoints": {
    "client": [
      "com.hawkslol.zpbw.ZpbwClient"
    ]
  },
  "mixins": [
    "zpbw.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=25",
    "fabric-api": ">=${fabric_api_version}",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}"
  },
  "authors": [
    "hawkslol"
  ],
  "contact": {
    "sources": "https://github.com/hawkzlol/zpbw",
    "issues": "https://github.com/hawkzlol/zpbw/issues"
  }
}
